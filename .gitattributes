# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Dart / Flutter text sources
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.storyboard text eol=lf
*.xib text eol=lf
*.pbxproj text eol=lf
*.xcconfig text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Binary files - prevent Git from corrupting or modifying line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg text eol=lf
*.pdf binary
*.apk binary
*.aab binary
*.ipa binary
*.jar binary
*.p8 binary
*.p12 binary
*.cer binary
*.mobileprovision binary
*.keystore binary
*.jks binary
*.zip binary
*.tar.gz binary
